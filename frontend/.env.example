# Copy this file to .env.local and update the URLs for your deployment.

# REST API base URL. It MUST include the /api suffix.
# Local:      http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Socket.io gateway URL. Do NOT add /api.
# Local:      http://localhost:5000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional: used only by next.config.ts rewrites if you prefer a same-origin proxy.
# BACKEND_URL=http://localhost:5000
