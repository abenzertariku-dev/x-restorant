              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 580,\n  \"spiceLevel\": \"Spicy\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/items/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "MENU_ITEM_ID"
                }
              ]
            },
            "description": "Admin/Manager only. Updates menu item fields."
