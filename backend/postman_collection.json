    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order (Table or Delivery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"dine_in\",\n  \"tableNumber\": 1,\n  \"customer\": {\n    \"name\": \"Abebe Beshu\",\n    \"phone\": \"+251911223344\"\n  },\n  \"items\": [\n    {\n      \"menuItemId\": \"ITEM_ID_HERE\",\n      \"qty\": 2,\n      \"notes\": \"Medium spice, extra injera please\"\n    }\n  ],\n  \"payment\": {\n    \"method\": \"telebirr\",\n    \"status\": \"pending\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Public. Places a new Dine-in, Takeaway, or Delivery order."
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?status=pending&type=dine_in&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Optional filter: pending, preparing, ready, served, delivered, settled, cancelled"
                },
                {
                  "key": "type",
                  "value": "dine_in",
                  "description": "Optional filter: dine_in, takeaway, delivery"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Staff only. Fetches orders with optional status/type filters."
          }
        },
