            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": {\n    \"en\": \"Shekla Tibs\",\n    \"am\": \"የሸክላ ጥብስ\"\n  },\n  \"description\": {\n    \"en\": \"Sizzling seasoned beef served in hot clay dish with peppers and rosemary\",\n    \"am\": \"በሙቅ የሸክላ ሳህን የሚቀርብ ልዩ የከብት ጥብስ\"\n  },\n  \"price\": 500,\n  \"category\": \"CATEGORY_ID_HERE\",\n  \"spiceLevel\": \"Medium\",\n  \"isFasting\": false,\n  \"prepTimeMinutes\": 15,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1544025162-d76694265947?w=600&auto=format&fit=crop&q=80\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "items"]
            },
            "description": "Admin/Manager only. Creates a new menu item."
          }
        },
        {
          "name": "Update Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
